<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" hgap="18" vgap="18" maxWidth="Infinity" styleClass="bento">
    <columnConstraints>
        <ColumnConstraints percentWidth="39" hgrow="ALWAYS" minWidth="0" fillWidth="true"/>
        <ColumnConstraints percentWidth="31" hgrow="ALWAYS" minWidth="0" fillWidth="true"/>
        <ColumnConstraints percentWidth="30" hgrow="ALWAYS" minWidth="0" fillWidth="true"/>
    </columnConstraints>
    <children>
        <VBox fx:id="accountsSlot" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="1" spacing="18" minWidth="0" fillWidth="true"/>
        <VBox fx:id="auditSlot" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="1" spacing="18" minWidth="0" fillWidth="true"/>
        <VBox fx:id="companiesSlot" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.columnSpan="1" spacing="18" minWidth="0" fillWidth="true"/>
        <VBox fx:id="activitySlot" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2" spacing="18" minWidth="0" fillWidth="true"/>
        <VBox fx:id="peopleSlot" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="1" spacing="18" minWidth="0" fillWidth="true"/>
    </children>
</GridPane>
